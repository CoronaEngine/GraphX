{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris failed exploration",
    "type": "object",
    "required": [
        "id",
        "scope",
        "task",
        "module",
        "hypothesis",
        "attempt",
        "evidence",
        "outcome",
        "failed_because",
        "retry_when",
        "related",
        "recorded_at",
        "promoted_from"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^EXP-[0-9]{4}$"
        },
        "scope": {
            "type": "string",
            "enum": [
                "task",
                "project"
            ]
        },
        "task": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}@r[0-9]{3}$"
        },
        "module": {
            "type": "string"
        },
        "hypothesis": {
            "type": "string"
        },
        "attempt": {
            "type": "string"
        },
        "evidence": {
            "type": "string"
        },
        "outcome": {
            "type": "string",
            "enum": [
                "rejected",
                "inconclusive"
            ]
        },
        "failed_because": {
            "type": "string"
        },
        "retry_when": {
            "type": "string"
        },
        "related": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "recorded_at": {
            "type": "string"
        },
        "promoted_from": {
            "type": [
                "string",
                "null"
            ]
        }
    }
}
