{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris validation",
    "type": "object",
    "required": [
        "task_id",
        "work_item_revision",
        "artifact_attempt",
        "subject_base_commit",
        "subject_head_commit",
        "subject_diff_hash",
        "validated_at",
        "verdict",
        "acceptance_results"
    ],
    "additionalProperties": false,
    "properties": {
        "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "work_item_revision": {
            "type": "integer",
            "minimum": 1
        },
        "artifact_attempt": {
            "type": "integer",
            "minimum": 1
        },
        "subject_base_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "subject_head_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "subject_diff_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "validated_at": {
            "type": "string"
        },
        "verdict": {
            "type": "string",
            "enum": [
                "PASS",
                "FAIL"
            ]
        },
        "acceptance_results": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "acceptance_id",
                    "command_or_check",
                    "cwd",
                    "environment_summary",
                    "started_at",
                    "exit_code",
                    "result",
                    "output_path_or_hash"
                ],
                "properties": {
                    "acceptance_id": {
                        "type": "string",
                        "pattern": "^AC-[0-9]{2}$"
                    },
                    "command_or_check": {
                        "type": "string"
                    },
                    "cwd": {
                        "type": "string"
                    },
                    "environment_summary": {
                        "type": "string"
                    },
                    "started_at": {
                        "type": "string"
                    },
                    "exit_code": {
                        "type": "integer"
                    },
                    "result": {
                        "type": "string",
                        "enum": [
                            "PASS",
                            "FAIL"
                        ]
                    },
                    "output_path_or_hash": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
