{
    "adapter_version": 3,
    "host_id": "claude-code",
    "display_name": "Claude Code",
    "skill_target": ".claude/skills",
    "invocation_prefix": "/",
    "entry_skill": "engineering-task",
    "capabilities": {
        "structured_user_input": true,
        "worker_create": true,
        "worker_status": true,
        "worker_resume": true,
        "stable_worker_identity": true
    },
    "entry_frontmatter": [
        "disable-model-invocation: true"
    ],
    "skill_overlay_root": null,
    "skill_appendix_root": "skill-appendices",
    "project_mcp": {
        "server_id": "polaris-codegraph",
        "format": "claude-json",
        "target": ".mcp.json",
        "command": "python3",
        "args": [
            "tools/polaris/scripts/code_intelligence_mcp.py",
            "--repo",
            "."
        ]
    },
    "files": [
        {
            "source": "agents/polaris-implementer.md",
            "target": ".claude/agents/polaris-implementer.md",
            "overwrite": true
        },
        {
            "source": "agents/polaris-reviewer.md",
            "target": ".claude/agents/polaris-reviewer.md",
            "overwrite": true
        },
        {
            "source": "CLAUDE.md",
            "target": "CLAUDE.md",
            "overwrite": false
        }
    ]
}
