{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris project",
    "type": "object",
    "required": [
        "project_id",
        "polaris_version",
        "workflow_version",
        "active_tasks"
    ],
    "additionalProperties": false,
    "properties": {
        "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "polaris_version": {
            "type": "string",
            "pattern": "^0\\.1\\.[0-9]+$"
        },
        "workflow_version": {
            "type": "string",
            "pattern": "^0\\.1\\.[0-9]+$"
        },
        "active_tasks": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^TASK-[0-9]{4}$"
            }
        }
    }
}
