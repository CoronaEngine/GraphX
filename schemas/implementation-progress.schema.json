{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris live implementation progress",
    "type": "object",
    "required": [
        "task_id",
        "work_item_revision",
        "artifact_attempt",
        "implementation_task",
        "implementer_session_id",
        "handoff_path",
        "handoff_sha256",
        "phase",
        "current_step_id",
        "implementation_steps",
        "checks",
        "blocker",
        "user_action",
        "updated_at"
    ],
    "additionalProperties": false,
    "properties": {
        "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "work_item_revision": {
            "type": "integer",
            "minimum": 1
        },
        "artifact_attempt": {
            "type": "integer",
            "minimum": 1
        },
        "implementation_task": {
            "type": "string"
        },
        "implementer_session_id": {
            "type": "string",
            "pattern": "^(Pending|[A-Za-z0-9][A-Za-z0-9._:-]{2,127})$"
        },
        "handoff_path": {
            "type": "string"
        },
        "handoff_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "phase": {
            "type": "string",
            "enum": [
                "QUEUED",
                "IMPLEMENTING",
                "TESTING",
                "CHECKPOINTING",
                "DOCUMENTING",
                "COMPLETED",
                "BLOCKED",
                "FAILED"
            ]
        },
        "current_step_id": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^STEP-[0-9]{3}$"
        },
        "implementation_steps": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "title",
                    "status",
                    "acceptance_ids",
                    "result"
                ],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^STEP-[0-9]{3}$"
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "PENDING",
                            "IN_PROGRESS",
                            "COMPLETED",
                            "BLOCKED",
                            "SKIPPED"
                        ]
                    },
                    "acceptance_ids": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "pattern": "^AC-[0-9]{2}$"
                        }
                    },
                    "result": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        },
        "checks": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "blocker": {
            "type": [
                "string",
                "null"
            ]
        },
        "user_action": {
            "type": [
                "string",
                "null"
            ]
        },
        "updated_at": {
            "type": "string"
        }
    }
}
