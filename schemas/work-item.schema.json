{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris work item",
    "type": "object",
    "required": [
        "id",
        "revision",
        "title",
        "rigor",
        "goal",
        "motivation",
        "scope",
        "constraints",
        "acceptance",
        "affected_modules",
        "base_commit",
        "risk_flags",
        "decision_owners",
        "approval_gates",
        "known_unknowns"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1
        },
        "title": {
            "type": "string"
        },
        "rigor": {
            "type": "string",
            "enum": [
                "R0",
                "R1",
                "R2"
            ]
        },
        "goal": {
            "type": "string"
        },
        "motivation": {
            "type": "string"
        },
        "scope": {
            "type": "object",
            "required": [
                "in",
                "out"
            ],
            "properties": {
                "in": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "out": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "constraints": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "acceptance": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "statement",
                    "evidence"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^AC-[0-9]{2}$"
                    },
                    "statement": {
                        "type": "string"
                    },
                    "evidence": {
                        "type": "string"
                    }
                }
            }
        },
        "affected_modules": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "base_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "risk_flags": {
            "type": "object",
            "required": [
                "public_api",
                "persistent_format",
                "irreversible_migration",
                "architecture_boundary",
                "concurrency",
                "security",
                "resource_lifetime",
                "critical_performance"
            ],
            "properties": {
                "public_api": {
                    "type": "boolean"
                },
                "persistent_format": {
                    "type": "boolean"
                },
                "irreversible_migration": {
                    "type": "boolean"
                },
                "architecture_boundary": {
                    "type": "boolean"
                },
                "concurrency": {
                    "type": "boolean"
                },
                "security": {
                    "type": "boolean"
                },
                "resource_lifetime": {
                    "type": "boolean"
                },
                "critical_performance": {
                    "type": "boolean"
                }
            }
        },
        "decision_owners": {
            "type": "object",
            "required": [
                "human",
                "agent"
            ],
            "properties": {
                "human": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "agent": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "approval_gates": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "implementation_dispatch": {
            "type": "object",
            "required": [
                "mode",
                "fallback",
                "same_local_project",
                "authorized"
            ],
            "additionalProperties": false,
            "properties": {
                "mode": {
                    "type": "string",
                    "const": "auto_new_task"
                },
                "fallback": {
                    "type": "string",
                    "const": "same_session"
                },
                "same_local_project": {
                    "type": "boolean",
                    "const": true
                },
                "authorized": {
                    "type": "boolean"
                }
            }
        },
        "review_dispatch": {
            "type": "object",
            "required": [
                "mode",
                "fallback",
                "same_local_project",
                "authorized"
            ],
            "additionalProperties": false,
            "properties": {
                "mode": {
                    "type": "string",
                    "const": "auto_new_task"
                },
                "fallback": {
                    "type": "string",
                    "const": "manual_handoff"
                },
                "same_local_project": {
                    "type": "boolean",
                    "const": true
                },
                "authorized": {
                    "type": "boolean"
                }
            }
        },
        "known_unknowns": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
