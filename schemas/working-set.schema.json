{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris working set",
    "type": "object",
    "required": [
        "task_id",
        "work_item_revision",
        "entries"
    ],
    "additionalProperties": false,
    "properties": {
        "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "work_item_revision": {
            "type": "integer",
            "minimum": 1
        },
        "entries": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "section",
                    "path",
                    "reason",
                    "discovered_from"
                ],
                "additionalProperties": false,
                "properties": {
                    "section": {
                        "type": "string",
                        "enum": [
                            "Documents",
                            "Code",
                            "Tests",
                            "Decisions",
                            "Explorations",
                            "Unknowns"
                        ]
                    },
                    "path": {
                        "type": "string",
                        "pattern": "^.+$"
                    },
                    "reason": {
                        "type": "string",
                        "pattern": "^.+$"
                    },
                    "discovered_from": {
                        "type": "string",
                        "pattern": "^.+$"
                    }
                }
            }
        }
    }
}
