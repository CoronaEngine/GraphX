{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris project recovery index",
    "type": "object",
    "required": [
        "project_id",
        "recommended_task",
        "recommended_next_action",
        "tasks",
        "links"
    ],
    "additionalProperties": false,
    "properties": {
        "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "recommended_task": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^TASK-[0-9]{4}$"
        },
        "recommended_next_action": {
            "type": "string",
            "pattern": "^.+$"
        },
        "tasks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "task_id",
                    "revision",
                    "status",
                    "title",
                    "blocker",
                    "next_action"
                ],
                "additionalProperties": false,
                "properties": {
                    "task_id": {
                        "type": "string",
                        "pattern": "^TASK-[0-9]{4}$"
                    },
                    "revision": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "DRAFT",
                            "QUALIFIED",
                            "PLANNED",
                            "IMPLEMENTING",
                            "REVIEWING",
                            "VALIDATING",
                            "VERIFIED",
                            "BLOCKED",
                            "CLOSED",
                            "CANCELLED"
                        ]
                    },
                    "title": {
                        "type": "string"
                    },
                    "blocker": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "required": [
                            "type",
                            "reason",
                            "decision_owner"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "type": {
                                "type": "string",
                                "pattern": "^.+$"
                            },
                            "reason": {
                                "type": "string",
                                "pattern": "^.+$"
                            },
                            "decision_owner": {
                                "type": "string",
                                "pattern": "^.+$"
                            }
                        }
                    },
                    "next_action": {
                        "type": "string",
                        "pattern": "^.+$"
                    }
                }
            }
        },
        "links": {
            "type": "object",
            "required": [
                "project_rules",
                "authority_state",
                "workflow"
            ],
            "additionalProperties": false,
            "properties": {
                "project_rules": {
                    "type": "string",
                    "const": "AGENTS.md"
                },
                "authority_state": {
                    "type": "string",
                    "const": ".polaris/project.json"
                },
                "workflow": {
                    "type": "string",
                    "const": ".polaris/workflow.json"
                }
            }
        }
    }
}
