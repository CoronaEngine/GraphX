{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris Doctor diagnostic report",
    "type": "object",
    "required": [
        "doctor_version",
        "status",
        "message",
        "repository",
        "mode",
        "summary",
        "checks"
    ],
    "additionalProperties": false,
    "properties": {
        "doctor_version": {
            "const": 1
        },
        "status": {
            "type": "string",
            "enum": [
                "PASS",
                "WARN",
                "FAIL",
                "ERROR"
            ]
        },
        "message": {
            "type": "string",
            "minLength": 1
        },
        "repository": {
            "type": "string",
            "minLength": 1
        },
        "mode": {
            "type": "string",
            "enum": [
                "source",
                "vendored",
                "unknown"
            ]
        },
        "summary": {
            "type": "object",
            "required": [
                "total",
                "passed",
                "warnings",
                "failed"
            ],
            "additionalProperties": false,
            "properties": {
                "total": {
                    "type": "integer",
                    "minimum": 0
                },
                "passed": {
                    "type": "integer",
                    "minimum": 0
                },
                "warnings": {
                    "type": "integer",
                    "minimum": 0
                },
                "failed": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "checks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "label",
                    "status",
                    "message",
                    "evidence",
                    "actions"
                ],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9:_-]+$"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "PASS",
                            "WARN",
                            "FAIL"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "minLength": 1
                    },
                    "evidence": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "actions": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        }
    }
}
