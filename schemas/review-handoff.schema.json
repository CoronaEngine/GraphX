{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris reviewer handoff",
    "type": "object",
    "required": [
        "task_id",
        "work_item_revision",
        "artifact_attempt",
        "rigor",
        "created_at",
        "implementer_session_id",
        "required_isolation",
        "subject_base_commit",
        "subject_head_commit",
        "subject_diff_hash",
        "previous_review",
        "package"
    ],
    "additionalProperties": false,
    "properties": {
        "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "work_item_revision": {
            "type": "integer",
            "minimum": 1
        },
        "artifact_attempt": {
            "type": "integer",
            "minimum": 1
        },
        "rigor": {
            "type": "string",
            "enum": [
                "R0",
                "R1",
                "R2"
            ]
        },
        "created_at": {
            "type": "string"
        },
        "implementer_session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "required_isolation": {
            "type": "string",
            "enum": [
                "fresh_session",
                "isolated_reviewer_agent",
                "r0_isolated_same_session"
            ]
        },
        "subject_base_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "subject_head_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "subject_diff_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "previous_review": {
            "type": [
                "object",
                "null"
            ]
        },
        "package": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "role",
                    "path",
                    "kind",
                    "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                    "role": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "file",
                            "directory"
                        ]
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    }
                }
            }
        }
    }
}
