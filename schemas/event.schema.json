{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris transition event",
    "type": "object",
    "required": [
        "sequence",
        "timestamp",
        "event",
        "from",
        "to",
        "task_id",
        "polaris_version",
        "workflow_version",
        "current_revision",
        "rigor",
        "blocked_from",
        "blocker",
        "artifacts",
        "subject"
    ],
    "properties": {
        "sequence": {
            "type": "integer",
            "minimum": 0
        },
        "timestamp": {
            "type": "string"
        },
        "event": {
            "type": "string"
        },
        "gate": {
            "type": "string"
        },
        "migration_id": {
            "type": "string"
        },
        "previous_polaris_version": {
            "type": "string"
        },
        "previous_workflow_version": {
            "type": "string"
        },
        "from": {
            "type": [
                "string",
                "null"
            ]
        },
        "to": {
            "type": "string"
        },
        "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "polaris_version": {
            "type": "string"
        },
        "workflow_version": {
            "type": "string"
        },
        "current_revision": {
            "type": "integer",
            "minimum": 1
        },
        "rigor": {
            "type": "string",
            "enum": [
                "R0",
                "R1",
                "R2"
            ]
        },
        "blocked_from": {
            "type": [
                "string",
                "null"
            ]
        },
        "blocker": {
            "type": [
                "object",
                "null"
            ]
        },
        "artifacts": {
            "type": "object"
        },
        "subject": {
            "type": [
                "object",
                "null"
            ]
        }
    }
}
