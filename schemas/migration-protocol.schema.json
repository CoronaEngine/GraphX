{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris migration protocol",
    "type": "object",
    "required": [
        "protocol_version",
        "steps"
    ],
    "additionalProperties": false,
    "properties": {
        "protocol_version": {
            "const": 1
        },
        "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "migration_id",
                    "from_polaris_version",
                    "to_polaris_version",
                    "from_workflow_version",
                    "to_workflow_version",
                    "project_strategy",
                    "task_strategy"
                ],
                "additionalProperties": false,
                "properties": {
                    "migration_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9.-]+-to-[a-z0-9.-]+$"
                    },
                    "from_polaris_version": {
                        "type": "string",
                        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "to_polaris_version": {
                        "type": "string",
                        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "from_workflow_version": {
                        "type": "string",
                        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "to_workflow_version": {
                        "type": "string",
                        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "project_strategy": {
                        "const": "replace_version"
                    },
                    "task_strategy": {
                        "const": "append_version_event"
                    }
                }
            }
        }
    }
}
