{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris human change decision",
    "type": "object",
    "required": [
        "decision_id",
        "approved_by",
        "approved_at",
        "approval_gate",
        "work_item_revision",
        "plan_hash",
        "subject_diff_hash",
        "decision"
    ],
    "additionalProperties": false,
    "properties": {
        "decision_id": {
            "type": "string",
            "pattern": "^CD-[0-9]{4}$"
        },
        "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "plan_decision_id": {
            "type": "string",
            "pattern": "^PD-[0-9]{3}$"
        },
        "approved_by": {
            "type": "string"
        },
        "approved_at": {
            "type": "string"
        },
        "approval_gate": {
            "type": "string"
        },
        "work_item_revision": {
            "type": "integer",
            "minimum": 1
        },
        "plan_hash": {
            "type": [
                "string",
                "null"
            ]
        },
        "subject_diff_hash": {
            "type": [
                "string",
                "null"
            ]
        },
        "decision": {
            "type": "string"
        }
    }
}
