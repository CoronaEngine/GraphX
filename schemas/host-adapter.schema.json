{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris host adapter",
    "type": "object",
    "required": [
        "adapter_version",
        "host_id",
        "display_name",
        "skill_target",
        "invocation_prefix",
        "entry_skill",
        "capabilities",
        "entry_frontmatter",
        "skill_overlay_root",
        "skill_appendix_root",
        "project_mcp",
        "files"
    ],
    "additionalProperties": false,
    "properties": {
        "adapter_version": {
            "const": 3
        },
        "host_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "display_name": {
            "type": "string",
            "minLength": 1
        },
        "skill_target": {
            "type": "string",
            "minLength": 1
        },
        "invocation_prefix": {
            "type": "string",
            "minLength": 1
        },
        "entry_skill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "capabilities": {
            "type": "object",
            "required": [
                "structured_user_input",
                "worker_create",
                "worker_status",
                "worker_resume",
                "stable_worker_identity"
            ],
            "additionalProperties": false,
            "properties": {
                "structured_user_input": {
                    "type": "boolean"
                },
                "worker_create": {
                    "type": "boolean"
                },
                "worker_status": {
                    "type": "boolean"
                },
                "worker_resume": {
                    "type": "boolean"
                },
                "stable_worker_identity": {
                    "type": "boolean"
                }
            }
        },
        "entry_frontmatter": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "skill_overlay_root": {
            "type": [
                "string",
                "null"
            ]
        },
        "skill_appendix_root": {
            "type": [
                "string",
                "null"
            ]
        },
        "project_mcp": {
            "type": "object",
            "required": [
                "server_id",
                "format",
                "target",
                "command",
                "args"
            ],
            "additionalProperties": false,
            "properties": {
                "server_id": {
                    "const": "polaris-codegraph"
                },
                "format": {
                    "enum": [
                        "codex-toml",
                        "claude-json"
                    ]
                },
                "target": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "const": "python3"
                },
                "args": {
                    "const": [
                        "tools/polaris/scripts/code_intelligence_mcp.py",
                        "--repo",
                        "."
                    ]
                }
            }
        },
        "files": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "source",
                    "target",
                    "overwrite"
                ],
                "additionalProperties": false,
                "properties": {
                    "source": {
                        "type": "string",
                        "minLength": 1
                    },
                    "target": {
                        "type": "string",
                        "minLength": 1
                    },
                    "overwrite": {
                        "type": "boolean"
                    }
                }
            }
        }
    }
}
