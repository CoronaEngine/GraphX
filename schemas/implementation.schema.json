{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris implementation record",
    "type": "object",
    "required": [
        "task_id",
        "work_item_revision",
        "artifact_attempt",
        "implementer_session_id",
        "implementation_handoff_path",
        "implementation_handoff_sha256",
        "subject_base_commit",
        "subject_head_commit",
        "subject_diff_hash",
        "deviations",
        "checks"
    ],
    "additionalProperties": false,
    "properties": {
        "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "work_item_revision": {
            "type": "integer",
            "minimum": 1
        },
        "artifact_attempt": {
            "type": "integer",
            "minimum": 1
        },
        "implementer_session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "implementation_handoff_path": {
            "type": "string",
            "pattern": "^implementations/r[0-9]{3}/handoff-[0-9]{3}\\.json$"
        },
        "implementation_handoff_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "subject_base_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "subject_head_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "subject_diff_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "deviations": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "checks": {
            "type": "array",
            "items": {
                "type": "object"
            }
        }
    }
}
