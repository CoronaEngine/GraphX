{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris task physical location registry",
    "type": "object",
    "required": [
        "registry_version",
        "locations"
    ],
    "additionalProperties": false,
    "properties": {
        "registry_version": {
            "type": "integer",
            "const": 1
        },
        "locations": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "task_id",
                    "path"
                ],
                "additionalProperties": false,
                "properties": {
                    "task_id": {
                        "type": "string",
                        "pattern": "^TASK-[0-9]{4}$"
                    },
                    "path": {
                        "type": "string",
                        "pattern": "^\\.polaris/(?:[A-Za-z0-9._-]+/)*TASK-[0-9]{4}$"
                    }
                }
            }
        }
    }
}
