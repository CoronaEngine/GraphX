{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Polaris implementation handoff",
    "type": "object",
    "required": [
        "task_id",
        "work_item_revision",
        "artifact_attempt",
        "rigor",
        "created_at",
        "preferred_isolation",
        "subject_base_commit",
        "previous_review",
        "output_path",
        "progress_json_path",
        "package"
    ],
    "additionalProperties": false,
    "properties": {
        "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
        },
        "work_item_revision": {
            "type": "integer",
            "minimum": 1
        },
        "artifact_attempt": {
            "type": "integer",
            "minimum": 1
        },
        "rigor": {
            "type": "string",
            "enum": [
                "R0",
                "R1",
                "R2"
            ]
        },
        "created_at": {
            "type": "string"
        },
        "preferred_isolation": {
            "type": "string",
            "enum": [
                "fresh_session"
            ]
        },
        "subject_base_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "previous_review": {
            "type": [
                "object",
                "null"
            ]
        },
        "output_path": {
            "type": "string",
            "pattern": "^implementations/r[0-9]{3}/attempt-[0-9]{3}\\.json$"
        },
        "progress_json_path": {
            "type": "string",
            "pattern": "^\\.polaris/tasks/TASK-[0-9]{4}/runtime/progress\\.json$"
        },
        "package": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "role",
                    "path",
                    "kind",
                    "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                    "role": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "file",
                            "directory"
                        ]
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    }
                }
            }
        }
    }
}
